{
  "name": "chord-browser",
  "productName": "Chord",
  "version": "0.41.0",
  "description": "An open-source browser inspired by Arc: sidebar tabs, spaces, command bar, split view.",
  "license": "MIT",
  "main": "dist/main.js",
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "start": "npm run build && electron .",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"test/**/*.test.ts\"",
    "dist": "npm run build && electron-builder",
    "dist:mac": "npm run build && electron-builder --mac"
  },
  "devDependencies": {
    "@types/node": "^24",
    "electron": "github:castlabs/electron-releases#v44.9.3+wvcus",
    "electron-builder": "^26",
    "esbuild": "^0.28",
    "typescript": "^5.9"
  },
  "build": {
    "appId": "org.chordbrowser.app",
    "productName": "Chord",
    "electronVersion": "44.9.3+wvcus",
    "electronDownload": {
      "mirror": "https://github.com/castlabs/electron-releases/releases/download/"
    },
    "afterPack": "build/afterPack.js",
    "files": [
      "dist/**",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "mac": {
      "icon": "build/icon.png",
      "category": "public.app-category.productivity",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        }
      ],
      "hardenedRuntime": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "identity": "-"
    },
    "linux": {
      "icon": "build/icon.png",
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Network",
      "maintainer": "sirmmo"
    },
    "win": {
      "icon": "build/icon.png",
      "target": [
        "nsis"
      ]
    },
    "artifactName": "Chord-${version}-${os}-${arch}.${ext}",
    "publish": {
      "provider": "github",
      "owner": "sirmmo",
      "repo": "chord"
    },
    "nsis": {
      "artifactName": "Chord-${version}-${os}-${arch}-setup.${ext}",
      "oneClick": true,
      "perMachine": false
    }
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@ghostery/adblocker-electron": "^2.20.1",
    "@mozilla/readability": "^0.6.0",
    "electron-updater": "^6.8.11",
    "hash-wasm": "^4.12.0",
    "kdbxweb": "^2.1.1"
  },
  "allowScripts": {
    "electron": true,
    "esbuild": true,
    "electron-winstaller": true
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/sirmmo/chord.git"
  },
  "homepage": "https://ingmmo.com/chord/"
}
